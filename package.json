{
	"name": "isly",
	"version": "1.10.0",
	"description": "Library for type checking.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/utily/isly.git"
	},
	"bugs": {
		"url": "https://github.com/utily/library-template/issues"
	},
	"homepage": "https://github.com/utily",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"git": {
		"tagName": "release-${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome format .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.4",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@vitest/coverage-v8": "^5.1.2",
		"conventional-changelog-conventionalcommits": "^9.3.0",
		"rimraf": "^6.1.4",
		"semantic-release": "^26.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	}
}
